# --- Site (.env.local for `pnpm dev`, container env in production) ---
# Where the site reaches Ghost. Can be private (tailnet, docker network).
GHOST_URL=http://localhost:2368
# Content API key of the "kshyr.dev site" integration; `pnpm ghost:setup` writes it.
GHOST_CONTENT_API_KEY=

# --- Scripts only (ghost:setup / ghost:seed); never needed by the site ---
GHOST_ADMIN_API_KEY=
GHOST_ADMIN_EMAIL=kostya.shirolapov@gmail.com
GHOST_ADMIN_PASSWORD=

# --- compose.yaml (.env next to it, or the Komodo stack environment) ---
# GHOST_ADMIN_URL=https://ghost.your-tailnet.ts.net
# GHOST_BIND=127.0.0.1
# GHOST_DB_PASSWORD=
# GHOST_DB_ROOT_PASSWORD=
# GHOST_DEVICE_VERIFICATION=false
# SITE_IMAGE=ghcr.io/kshyr/kshyr.dev:latest

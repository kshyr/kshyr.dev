---
import Logo from "./Logo.astro";

const nav = [
  { name: "Home", href: "/" },
  { name: "Blog", href: "/blog" },
  { name: "Projects", href: "/projects" },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="flex h-24 items-center justify-between pr-4">
  <a href="/" class="flex h-8 w-10 items-center justify-center md:w-14 lg:w-auto" aria-label="kshyr.dev home">
    <Logo />
  </a>
  <nav aria-label="Main">
    <ul class="flex items-center gap-5 font-display md:gap-8">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
              class="text-sm font-bold tracking-wide text-foreground no-underline transition-colors select-none hover:text-muted-foreground active:text-muted-foreground/70 md:text-[16px]"
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

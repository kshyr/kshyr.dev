---
import ScrollText from "@lucide/astro/icons/scroll-text";
import GithubIcon from "./GithubIcon.astro";
import ConceptBadge from "@/components/ConceptBadge.astro";
import type { Entry } from "@/lib/types";

interface Props {
  entry: Entry;
  index: number;
}
const { entry, index } = Astro.props;
const href = `/${entry.kind === "project" ? "projects" : "blog"}/${entry.slug}`;
---

<a
  href={href}
  class="group block w-96 max-w-full rounded-xl border border-transparent bg-card text-card-foreground no-underline shadow transition-colors select-none hover:border-t-primary/10 hover:border-b-border hover:bg-secondary hover:text-card-foreground active:bg-secondary/70"
  data-intro-item="card"
  data-index={index}
>
  <div class="flex w-full flex-col gap-1 p-6">
    <div class="mb-1 flex min-h-4 w-full items-center justify-between gap-4" data-intro-part="title">
      <h3 class="max-w-[16rem] pt-0 text-left text-base leading-tight font-semibold tracking-tight">{entry.title}</h3>
      {
        entry.kind === "blog" ? (
          <ScrollText width={20} aria-hidden="true" />
        ) : (
          <GithubIcon />
        )
      }
    </div>
    <p class="py-0 text-left text-sm text-muted-foreground" data-intro-part="description">{entry.description}</p>
    <ul class="flex flex-wrap gap-2 pt-1" aria-label="Tags">
      {entry.isIdea && <li data-intro-part="badge"><ConceptBadge /></li>}
      {
        entry.tags.map((tag) => (
          <li
            class="inline-flex items-center rounded-md border border-transparent bg-secondary px-2.5 py-0.5 text-xs font-semibold text-secondary-foreground group-hover:border-primary/50"
            data-intro-part="badge"
          >
            {tag}
          </li>
        ))
      }
    </ul>
  </div>
</a>
